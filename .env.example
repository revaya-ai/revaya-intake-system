# Revaya AI - Intake System Environment Variables

# Google AI API Key (for agent inference)
GOOGLE_API_KEY=your_google_api_key_here

# SendGrid API Key (for email notifications)
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Email Configuration
FROM_EMAIL=system@revayaai.com
TO_EMAIL=shannon@revayaai.com

# Slack Webhook (for notifications to #revaya-leads)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Server Configuration
PORT=8000

# Optional: Google Drive API (for saving proposals)
# GOOGLE_DRIVE_CREDENTIALS_PATH=./credentials.json

# Airtable CRM Integration
AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=your_airtable_base_id
AIRTABLE_TABLE_ID=your_airtable_table_id
